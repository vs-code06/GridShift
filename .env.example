# GridShift Environment Configuration
# Copy to .env and fill in values

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=gridshift

# API
API_HOST=0.0.0.0
API_PORT=8000

# Data paths
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
ARTIFACTS_DIR=artifacts

# Simulation defaults
DEFAULT_NUM_MACHINES=10
DEFAULT_GPUS_PER_MACHINE=8
DEFAULT_CPU_PER_MACHINE=64
DEFAULT_MEMORY_PER_MACHINE=256

# Forecasting
FORECAST_HORIZON_MINUTES=30
FORECAST_INTERVAL_MINUTES=5

# PPO
PPO_CANDIDATE_K=10
PPO_TRAINING_TIMESTEPS=100000
PPO_NUM_SEEDS=5

